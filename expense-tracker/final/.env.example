# .env.example — Environment Variables Template
# ===============================================
#
# WHY THIS FILE EXISTS:
#   .env.example is a TEMPLATE that developers copy to create their .env file.
#   It shows all available configuration options with safe example values.
#
# HOW TO USE:
#   1. Copy this file:   cp .env.example .env
#   2. Edit .env with your actual values
#   3. NEVER commit .env to git (it's in .gitignore)
#
# WHY NOT COMMIT .env?
#   .env contains sensitive values (secret keys, database passwords, API keys).
#   If .env is committed to a public GitHub repo:
#   - Anyone can see your secrets
#   - Bots constantly scan GitHub for exposed credentials
#   - Companies have been hacked this way!
#
# The .env.example IS committed — it shows other developers what variables
# they need, without exposing any real secret values.

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=RainCode Expense Tracker
APP_ENV=development
APP_DEBUG=True

# Secret key for Flask sessions and flash messages
# In production: use a long random string. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-this-in-production

# ── Database ──────────────────────────────────────────────────────────────────
# MySQL server. Create the database and application user before starting Flask.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=expense_app
DB_PASSWORD=change-this-local-password
DB_NAME=expense_tracker
DB_CHARSET=utf8mb4
# MySQL accepts an offset such as +07:00 or +00:00 for the session timezone.
DB_TIME_ZONE=+07:00
DB_CONNECT_TIMEOUT=10

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Path to log file
LOG_FILE=logs/app.log

# ── Settings ──────────────────────────────────────────────────────────────────
# Number of recent expenses to show on dashboard
RECENT_EXPENSES_LIMIT=5

# Number of expenses per page (for future pagination feature)
EXPENSES_PER_PAGE=10
